   "source": [
    "class NeuralNetwork(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        # Flatten layer: Convert 28x28 image to a 784-dimensional vector\n",
    "        self.flatten = nn.Flatten()\n",
    "\n",
    "        # Multilayer Perceptron (MLP)\n",
    "        self.network = nn.Sequential(\n",
    "            nn.Linear(28 * 28, 128),\n",
    "            nn.ReLU(),\n",
    "\n",
    "            nn.Linear(128, 64),\n",
    "            nn.ReLU(),\n",
    "\n",
    "            nn.Linear(64, 10)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = self.flatten(x)\n",
    "        x = self.network(x)\n",
    "        return x\n"
   ]
  },
